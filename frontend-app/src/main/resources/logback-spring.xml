<?xml version="1.0" encoding="UTF-8"?>
<configuration>

<include resource="org/springframework/boot/logging/logback/base.xml"/>

<property name="CONSOLE_LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %clr(${PID}){magenta} %clr(---){faint} %clr([%15.15t]){cyan} %clr(%-40.40logger{39}){blue} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>

<logger name="org.springframework.web" level="INFO"/>
<logger name="org.springframework.boot.web.embedded.tomcat" level="INFO"/>
<logger name="com.mihaiciobotaru.eshop" level="DEBUG"/> <logger name="org.hibernate" level="INFO"/>
<logger name="org.springframework.security" level="INFO"/>

</configuration>